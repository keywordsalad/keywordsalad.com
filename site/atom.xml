---
changefreq: weekly
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{site_url}}</id>
  <title>{{siteTitle | escape_html}}</title>
  <subtitle>{{siteDescription | escape_html}}</subtitle>
  <icon>{{site_url}}/images/grass-256x256.png</icon>
  <link href="{{site_url | escape_html_uri}}" />
  <link rel="self" href="{{abs_url | escape_html_uri}}" />
  <updated>{{lastUpdated}}</updated>
  <author>
    <name>{{authorName | escape_html}}</name>
    <email>{{authorEmail | escape_html}}</email>
  </author>
  <rights>Copyright &#169; 2012-{{currentTime | date_as '%Y'}} Logan McGrath. All rights reserved.</rights>
  <generator uri="https://jaspervdj.be/hakyll/">Hakyll</generator>
  {{#for posts-}}
    <entry>
      <id>{{abs_url | escape_html_uri}}</id>
      <title>{{title | escape_html}}</title>
      <updated>{{updated | date_as robot_time}}</updated>
      <link rel="alternate" href="{{abs_url | escape_html_uri}}" />
      <summary type="html">{{teaser | escape_html}}</summary>
      <author>
        <name>{{author | escape_html}}</name>
        {{#if email}}<email>{{email | escape_html}}</email>{{#end-}}
      </author>
      <content type="html">{{body | escape_html}}</content>
    </entry>
  {{#end-}}
</feed>
