---
changefreq: weekly
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
  xmlns:atom="http://www.w3.org/2005/Atom"
  xmlns:dc="http://purl.org/dc/elements/1.1/">
<channel>
  <title>{{siteTitle | escape_html}}</title>
  <description>{{siteDescription | escape_html}}</description>
  <link>{{site_url}}</link>
  <atom:link href="{{abs_url | escape_html_uri}}" rel="self" type="application/rss+xml" />
  <image>
    <url>{{site_url}}/images/grass-256x256.png</url>
    <title>{{siteTitle}}</title>
    <link>{{site_url}}</link>
  </image>
  <category>Technology</category>
  <category>Software Engineering</category>
  <language>en-US</language>
  <managingEditor>{{authorEmail | escape_html}} ({{authorName | escape_html}})</managingEditor>
  <webMaster>{{authorEmail | escape_html}} ({{authorName | escape_html}})</webMaster>
  <pubDate>{{lastPublished | date_as rfc822}}</pubDate>
  <lastBuildDate>{{lastUpdated | date_as rfc822}}</lastBuildDate>
  <generator>Hakyll</generator>
  <copyright>Copyright &#169; 2012-{{currentTime | date_as '%Y'}} Logan McGrath. All rights reserved.</copyright>
  {{#for posts-}}
    <item>
      <title>{{title | escape_html}}</title>
      <description>{{description | escape_html}}</description>
      <dc:creator>{{author | escape_html}}</dc:creator>
      <link>{{abs_url | escape_html}}</link>
      <guid>{{abs_url | escape_html}}</guid>
      <pubDate>{{published | date_as rfc822}}</pubDate>
      {{#for tagList-}}
      <category>{{item | escape_html}}</category>
      {{#end-}}
    </item>
  {{#end-}}
</channel>
</rss>
